 {"eval":"(()=>{const g=window.__game,P=g.P;g.startMission(4);P.yaw=0;let fz=null;for(let d=22;d<40;d+=2){if(g.freeSpot(P.x,P.z-d)){fz=P.z-d;break;}}const b=g.MS.boss;if(fz!==null){b.x=P.x;b.z=fz;b.g.position.set(b.x,0,b.z);}for(const a of g.allies){a.x=P.x+3;a.z=P.z+4;}window.__b=b;window.__T={log:[],run(n,watch){const L=[];let last='';for(let i=0;i<n;i++){g.sim(1,1/30);if(b.bs!==last){last=b.bs;L.push([i,b.bs,Math.round(Math.hypot(b.x-P.x,b.z-P.z)*10)/10,Math.round(P.hp)]);}if(watch&&watch(i))break;}return L;}};return {P:[P.x,P.z],b:[b.x,b.z],hp:b.hp,kind:b.kind,sc:b.sc,stage:g.MS.i,title:g.OBJ.text}})()","log":"setup"},
